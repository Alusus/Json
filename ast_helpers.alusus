@merge class Json {
    function _isSupportedType (varType: ref[Spp.Ast.Type]) : Bool {
        @shared def strType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.String));
        @shared def charsPtrType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.CharsPtr));
        @shared def boolType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Bool));
        @shared def int32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Int[32]));
        @shared def int64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Int[64]));
        @shared def float32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Float[32]));
        @shared def float64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Float[64]));
        @shared def nullableStrType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Nullable[Root.Srl.String]));
        @shared def nullableBoolType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Nullable[Root.Bool]));
        @shared def nullableInt32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Nullable[Root.Int[32]]));
        @shared def nullableInt64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Nullable[Root.Int[64]]));
        @shared def nullableFloat32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Nullable[Root.Float[32]]));
        @shared def nullableFloat64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Nullable[Root.Float[64]]));
        @shared def arrNullableStrType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Nullable[Root.Srl.String]]));
        @shared def arrNullableBoolType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Nullable[Root.Bool]]));
        @shared def arrNullableInt32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Nullable[Root.Int[32]]]));
        @shared def arrNullableInt64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Nullable[Root.Int[64]]]));
        @shared def arrNullableFloat32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Nullable[Root.Float[32]]]));
        @shared def arrNullableFloat64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Nullable[Root.Float[64]]]));
        @shared def mapNullableStrType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Srl.String]]));
        @shared def mapNullableBoolType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Bool]]));
        @shared def mapNullableInt32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Int[32]]]));
        @shared def mapNullableInt64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Int[64]]]));
        @shared def mapNullableFloat32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Float[32]]]));
        @shared def mapNullableFloat64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Float[64]]]));
        @shared def mapArrNullableStrType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Srl.Nullable[Root.Srl.String]]]));
        @shared def mapArrNullableBoolType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Srl.Nullable[Root.Bool]]]));
        @shared def mapArrNullableInt32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Srl.Nullable[Root.Int[32]]]]));
        @shared def mapArrNullableInt64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Srl.Nullable[Root.Int[64]]]]));
        @shared def mapArrNullableFloat32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Srl.Nullable[Root.Float[32]]]]));
        @shared def mapArrNullableFloat64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Srl.Nullable[Root.Float[64]]]]));
        @shared def arrMapNullableStrType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Srl.String]]]));
        @shared def arrMapNullableBoolType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Bool]]]));
        @shared def arrMapNullableInt32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Int[32]]]]));
        @shared def arrMapNullableInt64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Int[64]]]]));
        @shared def arrMapNullableFloat32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Float[32]]]]));
        @shared def arrMapNullableFloat64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Srl.Nullable[Root.Float[64]]]]));
        @shared def arrStrType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.String]));
        @shared def arrBoolType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Bool]));
        @shared def arrInt32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Int[32]]));
        @shared def arrInt64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Int[64]]));
        @shared def arrFloat32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Float[32]]));
        @shared def arrFloat64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Float[64]]));
        @shared def mapStrType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.String]));
        @shared def mapBoolType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Bool]));
        @shared def mapInt32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Int[32]]));
        @shared def mapInt64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Int[64]]));
        @shared def mapFloat32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Float[32]]));
        @shared def mapFloat64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Float[64]]));
        @shared def mapArrStrType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Srl.String]]));
        @shared def mapArrBoolType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Bool]]));
        @shared def mapArrInt32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Int[32]]]));
        @shared def mapArrInt64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Int[64]]]));
        @shared def mapArrFloat32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Float[32]]]));
        @shared def mapArrFloat64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Map[Root.Srl.String, Root.Srl.Array[Root.Float[64]]]));
        @shared def arrMapStrType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Srl.String]]));
        @shared def arrMapBoolType: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Bool]]));
        @shared def arrMapInt32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Int[32]]]));
        @shared def arrMapInt64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Int[64]]]));
        @shared def arrMapFloat32Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Float[32]]]));
        @shared def arrMapFloat64Type: ref[Spp.Ast.Type](Spp.astMgr.traceType(ast Root.Srl.Array[Root.Srl.Map[Root.Srl.String, Root.Float[64]]]));
        return varType~ptr == strType~ptr
            or varType~ptr == charsPtrType~ptr
            or varType~ptr == boolType~ptr
            or varType~ptr == int32Type~ptr
            or varType~ptr == int64Type~ptr
            or varType~ptr == float32Type~ptr
            or varType~ptr == float64Type~ptr
            or varType~ptr == nullableStrType~ptr
            or varType~ptr == nullableBoolType~ptr
            or varType~ptr == nullableInt32Type~ptr
            or varType~ptr == nullableInt64Type~ptr
            or varType~ptr == nullableFloat32Type~ptr
            or varType~ptr == nullableFloat64Type~ptr
            or varType~ptr == arrNullableStrType~ptr
            or varType~ptr == arrNullableBoolType~ptr
            or varType~ptr == arrNullableInt32Type~ptr
            or varType~ptr == arrNullableInt64Type~ptr
            or varType~ptr == arrNullableFloat32Type~ptr
            or varType~ptr == arrNullableFloat64Type~ptr
            or varType~ptr == mapNullableStrType~ptr
            or varType~ptr == mapNullableBoolType~ptr
            or varType~ptr == mapNullableInt32Type~ptr
            or varType~ptr == mapNullableInt64Type~ptr
            or varType~ptr == mapNullableFloat32Type~ptr
            or varType~ptr == mapNullableFloat64Type~ptr
            or varType~ptr == mapArrNullableStrType~ptr
            or varType~ptr == mapArrNullableBoolType~ptr
            or varType~ptr == mapArrNullableInt32Type~ptr
            or varType~ptr == mapArrNullableInt64Type~ptr
            or varType~ptr == mapArrNullableFloat32Type~ptr
            or varType~ptr == mapArrNullableFloat64Type~ptr
            or varType~ptr == arrMapNullableStrType~ptr
            or varType~ptr == arrMapNullableBoolType~ptr
            or varType~ptr == arrMapNullableInt32Type~ptr
            or varType~ptr == arrMapNullableInt64Type~ptr
            or varType~ptr == arrMapNullableFloat32Type~ptr
            or varType~ptr == arrMapNullableFloat64Type~ptr
            or varType~ptr == arrStrType~ptr
            or varType~ptr == arrBoolType~ptr
            or varType~ptr == arrInt32Type~ptr
            or varType~ptr == arrInt64Type~ptr
            or varType~ptr == arrFloat32Type~ptr
            or varType~ptr == arrFloat64Type~ptr
            or varType~ptr == mapStrType~ptr
            or varType~ptr == mapBoolType~ptr
            or varType~ptr == mapInt32Type~ptr
            or varType~ptr == mapInt64Type~ptr
            or varType~ptr == mapFloat32Type~ptr
            or varType~ptr == mapFloat64Type~ptr
            or varType~ptr == mapArrStrType~ptr
            or varType~ptr == mapArrBoolType~ptr
            or varType~ptr == mapArrInt32Type~ptr
            or varType~ptr == mapArrInt64Type~ptr
            or varType~ptr == mapArrFloat32Type~ptr
            or varType~ptr == mapArrFloat64Type~ptr
            or varType~ptr == arrMapStrType~ptr
            or varType~ptr == arrMapBoolType~ptr
            or varType~ptr == arrMapInt32Type~ptr
            or varType~ptr == arrMapInt64Type~ptr
            or varType~ptr == arrMapFloat32Type~ptr
            or varType~ptr == arrMapFloat64Type~ptr;
    }
    
    // True for instances of the smart reference templates (SrdRef, UnqRef, WkRef)
    function _isSupportedSharedRef (varType: ref[Spp.Ast.Type]) : Bool {
        @shared def srdRefTemplate: ref[Core.Basic.TiObject](Root.Srl.SrdRef~ast);
        @shared def unqRefTemplate: ref[Core.Basic.TiObject](Root.Srl.UnqRef~ast);
        @shared def wkRefTemplate: ref[Core.Basic.TiObject](Root.Srl.WkRef~ast);
        if varType.getMyTypeInfo().typeName != "UserType" return false;
        def instanceScope: ref[Core.Data.Node](varType.owner);
        if instanceScope~ptr == 0 or instanceScope.owner~ptr == 0 return false;
        def template: ref[Core.Basic.TiObject](instanceScope.owner);
        return template~ptr == srdRefTemplate~ptr
            or template~ptr == unqRefTemplate~ptr
            or template~ptr == wkRefTemplate~ptr;
    }

    // Returns the type a smart reference points to. Expects a type accepted by _isSupportedSharedRef;
    // all of them hold their content in an `obj` reference field.
    function _getSharedRefContentType (varType: ref[Spp.Ast.Type]) : ref[Spp.Ast.Type] {
        def innerVars: Array[ref[Core.Basic.TiObject]] = Spp.astMgr.getClassVars(varType);
        def k: Int;
        for k = 0, k < innerVars.getLength(), ++k {
            if Spp.astMgr.getDefinitionName(innerVars(k)) == "obj" {
                return Spp.astMgr.tryGetDeepReferenceContentType(Spp.astMgr.traceType(innerVars(k)));
            }
        }
        return nullRef[Spp.Ast.Type];
    }

    // Builds the code that writes `target` (e.g. `obj.x` or `obj.x.obj`) as a JSON value: a nested stringfy call
    // for classes, appendJsonValue for everything else.
    function _buildStringifyValueAst (
        target: ref[Core.Basic.TiObject], valueType: ref[Spp.Ast.Type], isNestedClass: Bool,
        result: ref[SrdRef[Core.Basic.TiObject]]
    ) {
        if isNestedClass {
            Spp.astMgr.buildAst(
                (ast sb.append(stringfy[fieldType](target).buf)),
                Map[Srl.String, ref[Core.Basic.TiObject]]()
                    .set(String("target"), target)
                    .set(String("fieldType"), Core.Data.Ast.Passage(valueType)),
                result
            );
        } else {
            Spp.astMgr.buildAst(
                (ast sb.appendJsonValue(target)),
                Map[Srl.String, ref[Core.Basic.TiObject]]().set(String("target"), target),
                result
            );
        }
    }

    function _generateJsonStringify [T : type] () {
        def vars: Array[ref[Core.Basic.TiObject]] = Spp.astMgr.getClassVars(T~ast);

        def emittedCount: Int = 0;
        def i: Int;
        for i = 0, i < vars.getLength(), ++i {
            def varType: ref[Spp.Ast.Type](Spp.astMgr.traceType(vars(i)));
            def isRef: Bool(false);  
            def isSmartReference: Bool(false);
            def isNestedClass: Bool(false); 

            if not _isSupportedType(varType) {
                if varType.getMyTypeInfo().typeName == "ReferenceType" {
                    varType~ptr = Spp.astMgr.tryGetDeepReferenceContentType(varType)~ptr;
                    isRef = true;
                } else if _isSupportedSharedRef(varType) {
                    varType~ptr = _getSharedRefContentType(varType)~ptr;
                    isSmartReference = true;
                } else if varType.getMyTypeInfo().typeName == "UserType" {
                    isNestedClass = true;
                } else {
                    Spp.buildMgr.raiseBuildNotice("SPPH1015", 1, vars(i));
                    continue;
                }
                if not isNestedClass and not _isSupportedType(varType) {
                    // A reference (ref, SrdRef...) to a class is serialized as a nested object.
                    if not _isNestedClassType(varType) {
                        Spp.buildMgr.raiseBuildNotice("SPPH1015", 1, vars(i));
                        continue;
                    }
                    isNestedClass = true;
                }
            }

            def fieldName: String = Spp.astMgr.getDefinitionName(vars(i));

            if emittedCount > 0 {
               Spp.astMgr.insertAst(ast sb.append(','));
            }

            // The expression to read the value from: the field itself, or the content of a smart reference.
            def targetAst: SrdRef[Core.Basic.TiObject];
            if isSmartReference {
                Spp.astMgr.buildAst(
                    (ast obj.varName.obj),
                    Map[Srl.String, ref[Core.Basic.TiObject]]().set(String("varName"), Core.Data.Ast.Identifier(fieldName)),
                    targetAst
                );
            } else {
                Spp.astMgr.buildAst(
                    (ast obj.varName),
                    Map[Srl.String, ref[Core.Basic.TiObject]]().set(String("varName"), Core.Data.Ast.Identifier(fieldName)),
                    targetAst
                );
            }

            def valueAst: SrdRef[Core.Basic.TiObject];
            _buildStringifyValueAst(targetAst.obj, varType, isNestedClass, valueAst);

            if isRef or isSmartReference {
                Spp.astMgr.insertAst(
                    (ast {
                        sb.format("\"{{key}}\":");
                        if target~ptr == 0 {
                            sb.append("null");
                        } else {
                            valueCode
                        }
                    }),
                    Map[Srl.String, ref[Core.Basic.TiObject]]()
                        .set(String("key"), Core.Basic.TiStr(fieldName))
                        .set(String("target"), targetAst.obj)
                        .set(String("valueCode"), valueAst.obj)
                );
            } else {
                Spp.astMgr.insertAst(
                    (ast {
                        sb.format("\"{{key}}\":");
                        valueCode
                    }),
                    Map[Srl.String, ref[Core.Basic.TiObject]]()
                        .set(String("key"), Core.Basic.TiStr(fieldName))
                        .set(String("valueCode"), valueAst.obj)
                )
            }

            ++emittedCount;
        }
    }

    function _hasFunction (varType: ref[Spp.Ast.Type], name: CharsPtr) : Bool {
        def funcNames: Array[String] = Spp.astMgr.getClassFuncNames(varType);
        def k: Int;
        for k = 0, k < funcNames.getLength(), ++k {
            if funcNames(k) == name return true;
        }
        return false;
    }

    function _isNestedClassType (varType: ref[Spp.Ast.Type]) : Bool {
        return varType.getMyTypeInfo().typeName == "UserType" and not _isSupportedSharedRef(varType);
    }

    // Builds the statement that fills `target` (e.g. `obj.x` or `obj.x.obj`) from `json(key)`: a cast for
    // supported types, or a nested parse for classes.
    function _buildParseFillAst (
        target: ref[Core.Basic.TiObject], contentType: ref[Spp.Ast.Type], fieldName: ref[String],
        result: ref[SrdRef[Core.Basic.TiObject]]
    ) {
        if _isSupportedType(contentType) {
            // An explicit cast is needed: with both Json~cast[T] and Json~cast[Nullable[T]] available,
            // assigning a Json to a Nullable[T] implicitly would match two Nullable assignment handlers.
            Spp.astMgr.buildAst(
                (ast target = json(key)~cast[fieldType]),
                Map[Srl.String, ref[Core.Basic.TiObject]]()
                    .set(String("target"), target)
                    .set(String("key"), Core.Data.Ast.StringLiteral(fieldName))
                    .set(String("fieldType"), Core.Data.Ast.Passage(contentType)),
                result
            );
        } else {
            Spp.astMgr.buildAst(
                (ast parse[fieldType](target, json(key))),
                Map[Srl.String, ref[Core.Basic.TiObject]]()
                    .set(String("target"), target)
                    .set(String("key"), Core.Data.Ast.StringLiteral(fieldName))
                    .set(String("fieldType"), Core.Data.Ast.Passage(contentType)),
                result
            );
        }
    }

    function _generateJsonParse [T : type] () {
        def vars: Array[ref[Core.Basic.TiObject]] = Spp.astMgr.getClassVars(T~ast);
        def i: Int;
        for i = 0, i < vars.getLength(), ++i {
            def varType: ref[Spp.Ast.Type](Spp.astMgr.traceType(vars(i)));
            def fieldName: String = Spp.astMgr.getDefinitionName(vars(i));
            def targetAst: SrdRef[Core.Basic.TiObject];
            def fillAst: SrdRef[Core.Basic.TiObject];

            if _isSupportedType(varType) or _isNestedClassType(varType) {
                Spp.astMgr.buildAst(
                    (ast obj.varName),
                    Map[Srl.String, ref[Core.Basic.TiObject]]().set(String("varName"), Core.Data.Ast.Identifier(fieldName)),
                    targetAst
                );
                _buildParseFillAst(targetAst.obj, varType, fieldName, fillAst);
                Spp.astMgr.insertAst(fillAst.obj);
            } else if varType.getMyTypeInfo().typeName == "ReferenceType" {
                def contentType: ref[Spp.Ast.Type](Spp.astMgr.tryGetDeepReferenceContentType(varType));
                if not _isSupportedType(contentType) and not _isNestedClassType(contentType) {
                    Spp.buildMgr.raiseBuildNotice("SPPH1015", 1, vars(i));
                    continue;
                }
                Spp.astMgr.buildAst(
                    (ast obj.varName),
                    Map[Srl.String, ref[Core.Basic.TiObject]]().set(String("varName"), Core.Data.Ast.Identifier(fieldName)),
                    targetAst
                );
                _buildParseFillAst(targetAst.obj, contentType, fieldName, fillAst);
                Spp.astMgr.insertAst(
                    (ast {
                        if json(key).isNull() {
                            obj.varName~ptr = 0;
                        } else {
                            obj.varName~no_deref = newObj[fieldType];
                            fillCode
                        }
                    }),
                    Map[Srl.String, ref[Core.Basic.TiObject]]()
                        .set(String("varName"), Core.Data.Ast.Identifier(fieldName))
                        .set(String("key"), Core.Data.Ast.StringLiteral(fieldName))
                        .set(String("fieldType"), Core.Data.Ast.Passage(contentType))
                        .set(String("fillCode"), fillAst.obj)
                );
            } else if _isSupportedSharedRef(varType) {
                def contentType: ref[Spp.Ast.Type](_getSharedRefContentType(varType));
                if (not _isSupportedType(contentType) and not _isNestedClassType(contentType))
                or not _hasFunction(varType, "construct") {
                    Spp.buildMgr.raiseBuildNotice("SPPH1015", 1, vars(i));
                    continue;
                }
                Spp.astMgr.buildAst(
                    (ast obj.varName.obj),
                    Map[Srl.String, ref[Core.Basic.TiObject]]().set(String("varName"), Core.Data.Ast.Identifier(fieldName)),
                    targetAst
                );
                _buildParseFillAst(targetAst.obj, contentType, fieldName, fillAst);
                Spp.astMgr.insertAst(
                    (ast {
                        if json(key).isNull() {
                            obj.varName.release();
                        } else {
                            obj.varName.construct();
                            fillCode
                        }
                    }),
                    Map[Srl.String, ref[Core.Basic.TiObject]]()
                        .set(String("varName"), Core.Data.Ast.Identifier(fieldName))
                        .set(String("key"), Core.Data.Ast.StringLiteral(fieldName))
                        .set(String("fillCode"), fillAst.obj)
                );
            } else {
                Spp.buildMgr.raiseBuildNotice("SPPH1015", 1, vars(i));
            }
        }
    }
}