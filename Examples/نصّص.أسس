استخدم مـتم؛

صنف شخص {
    عرف الاسم: بـعدم[نـص]؛
    عرف الوسوم: مـصفوفة[بـعدم[نـص]]؛
    عرف الدرجات: تـطبيق[نـص, بـعدم[نـص]]؛
    عرف البيانات: تـطبيق[نـص, مـصفوفة[بـعدم[نـص]]]؛
}

عرف ش: شخص()؛
ش.الاسم = بـعدم[نـص](نـص("سرمد"))؛

ش.الوسوم.أضف(بـعدم[نـص](نـص("مسؤول")))؛
