ش.الدرجات.حدد(نـص("رياضيات")، بـعدم[نـص](نـص("A")))؛
ش.الدرجات.حدد(نـص("فن")، بـعدم[نـص]())؛

عرف اللغات: مـصفوفة[بـعدم[نـص]]؛
اللغات.أضف(بـعدم[نـص](نـص("الأسس")))؛
اللغات.أضف(بـعدم[نـص](نـص("سي++")))؛
ش.البيانات.حدد(نـص("اللغات")، اللغات)؛

طـرفية.اطبع("%s\ج"، جـيسون.نصّص[شخص](ش).صوان)؛
