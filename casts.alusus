@merge class Json {
    use Srl;

    func _castArray [T: type] (json: ref[Json]): Array[T] {
        if not json.isArray() return Array[T]();

        def result : Array[T];
        def i : Int;

        for i = 0, i < json.values.getLength(), ++i {
            result.add(json(i)~cast[T]);
        }
        return result;
    }

    func _castMap [T: type] (json: ref[Json]): Map[String, T] {
        if not json.isObject() return Map[String, T]();

        def result : Map[String, T];
        def i : Int;

        for i = 0, i < json.keys.getLength(), ++i {
            result.set(json.keys(i), json.values(i)~cast[T]);
        }
        return result;
    }

    handler this~cast[Array[Nullable[String]]] { return Json._castArray[Nullable[String]](this); }
    handler this~cast[Array[Nullable[Int[64]]]] { return Json._castArray[Nullable[Int[64]]](this); }
    handler this~cast[Array[Nullable[Int[32]]]] { return Json._castArray[Nullable[Int[32]]](this); }
    handler this~cast[Array[Nullable[Float[64]]]] { return Json._castArray[Nullable[Float[64]]](this); }
    handler this~cast[Array[Nullable[Float[32]]]] { return Json._castArray[Nullable[Float[32]]](this); }
    handler this~cast[Array[Nullable[Bool]]] { return Json._castArray[Nullable[Bool]](this); }

    handler this~cast[Array[String]] { return Json._castArray[String](this); }
    handler this~cast[Array[Int[64]]] { return Json._castArray[Int[64]](this); }
    handler this~cast[Array[Int[32]]] { return Json._castArray[Int[32]](this); }
    handler this~cast[Array[Float[64]]] { return Json._castArray[Float[64]](this); }
    handler this~cast[Array[Float[32]]] { return Json._castArray[Float[32]](this); }
    handler this~cast[Array[Bool]] { return Json._castArray[Bool](this); }

    handler this~cast[Map[String, Nullable[String]]] { return Json._castMap[Nullable[String]](this); }
    handler this~cast[Map[String, Nullable[Int[64]]]] { return Json._castMap[Nullable[Int[64]]](this); }
    handler this~cast[Map[String, Nullable[Int[32]]]] { return Json._castMap[Nullable[Int[32]]](this); }
    handler this~cast[Map[String, Nullable[Float[64]]]] { return Json._castMap[Nullable[Float[64]]](this); }
    handler this~cast[Map[String, Nullable[Float[32]]]] { return Json._castMap[Nullable[Float[32]]](this); }
    handler this~cast[Map[String, Nullable[Bool]]] { return Json._castMap[Nullable[Bool]](this); }

    handler this~cast[Map[String, String]] { return Json._castMap[String](this); }
    handler this~cast[Map[String, Int[64]]] { return Json._castMap[Int[64]](this); }
    handler this~cast[Map[String, Int[32]]] { return Json._castMap[Int[32]](this); }
    handler this~cast[Map[String, Float[64]]] { return Json._castMap[Float[64]](this); }
    handler this~cast[Map[String, Float[32]]] { return Json._castMap[Float[32]](this); }
    handler this~cast[Map[String, Bool]] { return Json._castMap[Bool](this); }

    handler this~cast[Map[String, Array[Nullable[String]]]] { return Json._castMap[Array[Nullable[String]]](this); }
    handler this~cast[Map[String, Array[Nullable[Int[64]]]]] { return Json._castMap[Array[Nullable[Int[64]]]](this); }
    handler this~cast[Map[String, Array[Nullable[Int[32]]]]] { return Json._castMap[Array[Nullable[Int[32]]]](this); }
    handler this~cast[Map[String, Array[Nullable[Float[64]]]]] { return Json._castMap[Array[Nullable[Float[64]]]](this); }
    handler this~cast[Map[String, Array[Nullable[Float[32]]]]] { return Json._castMap[Array[Nullable[Float[32]]]](this); }
    handler this~cast[Map[String, Array[Nullable[Bool]]]] { return Json._castMap[Array[Nullable[Bool]]](this); }

    handler this~cast[Map[String, Array[String]]] { return Json._castMap[Array[String]](this); }
    handler this~cast[Map[String, Array[Int[64]]]] { return Json._castMap[Array[Int[64]]](this); }
    handler this~cast[Map[String, Array[Int[32]]]] { return Json._castMap[Array[Int[32]]](this); }
    handler this~cast[Map[String, Array[Float[64]]]] { return Json._castMap[Array[Float[64]]](this); }
    handler this~cast[Map[String, Array[Float[32]]]] { return Json._castMap[Array[Float[32]]](this); }
    handler this~cast[Map[String, Array[Bool]]] { return Json._castMap[Array[Bool]](this); }

    handler this~cast[Array[Map[String, Nullable[String]]]] { return Json._castArray[Map[String, Nullable[String]]](this); }
    handler this~cast[Array[Map[String, Nullable[Int[64]]]]] { return Json._castArray[Map[String, Nullable[Int[64]]]](this); }
    handler this~cast[Array[Map[String, Nullable[Int[32]]]]] { return Json._castArray[Map[String, Nullable[Int[32]]]](this); }
    handler this~cast[Array[Map[String, Nullable[Float[64]]]]] { return Json._castArray[Map[String, Nullable[Float[64]]]](this); }
    handler this~cast[Array[Map[String, Nullable[Float[32]]]]] { return Json._castArray[Map[String, Nullable[Float[32]]]](this); }
    handler this~cast[Array[Map[String, Nullable[Bool]]]] { return Json._castArray[Map[String, Nullable[Bool]]](this); }

    handler this~cast[Array[Map[String, String]]] { return Json._castArray[Map[String, String]](this); }
    handler this~cast[Array[Map[String, Int[64]]]] { return Json._castArray[Map[String, Int[64]]](this); }
    handler this~cast[Array[Map[String, Int[32]]]] { return Json._castArray[Map[String, Int[32]]](this); }
    handler this~cast[Array[Map[String, Float[64]]]] { return Json._castArray[Map[String, Float[64]]](this); }
    handler this~cast[Array[Map[String, Float[32]]]] { return Json._castArray[Map[String, Float[32]]](this); }
    handler this~cast[Array[Map[String, Bool]]] { return Json._castArray[Map[String, Bool]](this); }

    handler this~cast[Nullable[String]] {
        if this.isNull() return Nullable[String]()
        else return Nullable[String](parseString(this.rawValue, this.rawValue.getLength()));
    }

    handler this~cast[Nullable[Int[64]]] {
        if this.isNull() return Nullable[Int[64]]()
        else return Nullable[Int[64]](String.parseInt(this.rawValue));
    }

    handler this~cast[Nullable[Int[32]]] {
        if this.isNull() return Nullable[Int[32]]()
        else return Nullable[Int[32]](String.parseInt(this.rawValue));
    }

    handler this~cast[Nullable[Float[64]]] {
        if this.isNull() return Nullable[Float[64]]()
        else return Nullable[Float[64]](String.parseFloat(this.rawValue));
    }

    handler this~cast[Nullable[Float[32]]] {
        if this.isNull() return Nullable[Float[32]]()
        else return Nullable[Float[32]](String.parseFloat(this.rawValue));
    }

    handler this~cast[Nullable[Bool]] {
        if this.isNull() return Nullable[Bool]()
        else if this.rawValue == "true" return Nullable[Bool](true)
        else return Nullable[Bool](false);
    }

    handler this~cast[String] {
        if this.isNull() return String()
        else return parseString(this.rawValue, this.rawValue.getLength());
    }

    handler this~cast[Int[64]] {
        if this.isNull() return 0
        else return String.parseInt(this.rawValue);
    }

    handler this~cast[Int[32]] {
        if this.isNull() return 0
        else return String.parseInt(this.rawValue);
    }

    handler this~cast[Float[64]] {
        if this.isNull() return 0
        else return String.parseFloat(this.rawValue);
    }

    handler this~cast[Float[32]] {
        if this.isNull() return 0
        else return String.parseFloat(this.rawValue);
    }

    handler this~cast[Bool] {
        return this.rawValue == "true";
    }

    handler this~cast[CharsPtr] {
        if this.isNull() return 0~cast[CharsPtr];
        def str: String = parseString(this.rawValue, this.rawValue.getLength());
        def buf: CharsPtr = Memory.alloc(str.getLength() + 1)~cast[CharsPtr];
        Memory.copy(buf, str.buf, str.getLength() + 1);
        return buf;
    }
}
