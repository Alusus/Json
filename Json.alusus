import "Srl/Array.alusus";
import "Srl/String.alusus";
import "Srl/StringBuilder.alusus";
import "Srl/Nullable.alusus";
import "Srl/Map.alusus";
class Json {
    use Srl;
    def keys: Array[String];
    def values: Array[Json];
    def rawValue: String;

    handler this~init() {}

    handler this~init(str: ptr[array[Char]]) this.initialize(str);

    handler this~init(json: ref[Json]) {
        this = json;
    }

    handler this = ptr[array[Char]] this.initialize(value);

    handler this = ref[Json] {
        this.rawValue = value.rawValue
        this.keys = value.keys
        this.values = value.values
    }

    handler this.initialize(str: CharsPtr) {
        this.rawValue.clear();
        this.keys.clear();
        this.values.clear();
        this.parse(str);
    }

    handler this.parse(str: CharsPtr) {
        while isSpace(str~cnt(0)) str = str + 1;
        if str~cnt(0) == '{' {
            str = str + 1;
            while str~cnt(0) != 0 and str~cnt(0) != '}' {
                def commaIndex: ArchInt = findSeparator(str, ',');
                if commaIndex == 0 break;
                def colonIndex: ArchInt = findSeparator(str, ':');
                if colonIndex != 0 {
                    this.keys.add(parseString(str, colonIndex));
                    this.values.add(Json(str + colonIndex + 1));
                }
                str = str + commaIndex;
                if str~cnt(0) == ',' str = str + 1;
            }
        } else if str~cnt(0) == '[' {
            str = str + 1;
            while str~cnt(0) != 0 and str~cnt(0) != ']' {
                def commaIndex: ArchInt = findSeparator(str, ',');
                if commaIndex == 0 break;
                this.values.add(Json(str));
                str = str + commaIndex;
                if str~cnt(0) == ',' str = str + 1;
            }
        } else {
            def i: ArchInt = 0;
            def endIndex: ArchInt = 0;
            def level: Int = 0;
            while not isAtEnd(str~cnt(i), level, false) {
                if str~cnt(i) == '\\' { ++i }
                else if str~cnt(i) == '"' level = 1 - level;
                if not isSpace(str~cnt(i)) endIndex = i + 1;
                ++i;
            }
            this.rawValue = String(str, endIndex);
        }
    }

    func findSeparator(str: CharsPtr, separator: Char): ArchInt {
        @shared def skipOperators: Array[Char]({ '{', '[', '"', '\'' });
        @shared def skipOperatorsClose: Array[Char]({ '}', ']', '"', '\'' });
        def stack: array[Char, 500];
        def stackLen: Int = 0;

        def start: ArchInt = 0;
        def i: ArchInt;
        for i = 0, not isAtEnd(str~cnt(i), stackLen, separator != ':'), ++i {
            if str~cnt(i) == '\\' {
                ++i;
                continue;
            }
            def opInd: Int;
            if stackLen > 0 and str~cnt(i) == stack(stackLen - 1) {
                --stackLen;
            } else if stackLen == 0 or stack(stackLen - 1) != '"' {
                for opInd = 0, opInd < skipOperators.getLength(), opInd++ {
                    if str~cnt(i) == skipOperators(opInd) {
                        stack(stackLen++) = skipOperatorsClose(opInd);
                        // Break if we reach the stack limit to avoid memory violation. This will only happen if the
                        // JSON file is 500 levels deep, which wouldn't happen in any practical situation.
                        if stackLen == 500 break 2;
                    }
                }
            }
        }

        return i;
    };

    func isAtEnd(c: Char, stackSize: Int, acceptColon: Bool): Bool {
        if c == 0 return true;
        return stackSize == 0 and (c == '}' or c == ']' or c == ',' or (c == ':' and not acceptColon));
    }

    func isSpace(c: Char): Bool {
        return c == ' ' or c == '\n' or c == '\t' or c == '\r'
    }

    func parseString(input: CharsPtr, len: ArchInt): String {
        def result: StringBuilder(len, (len + 1) / 2);
        def inStr: Bool = false;
        def i: ArchInt;
        for i = 0, i < len, ++i {
            if inStr {
                if input~cnt(i) == '"' break;
                if input~cnt(i) == '\\' {
                    ++i;
                    if input~cnt(i) == 'n' result += '\n'
                    else if input~cnt(i) == 'r' result += '\r'
                    else if input~cnt(i) == 't' result += '\t'
                    else result += input~cnt(i);
                } else {
                    result += input~cnt(i);
                }
            } else {
                if input~cnt(i) == '"' inStr = true;
            }
        }
        return result;
    }

    handler this.getLength(): Int {
        return this.values.getLength();
    }

    handler this.getKey(i: Int): String {
        if i < 0 or i >= this.keys.getLength() return String();
        return this.keys(i);
    }

    handler this(key: CharsPtr): ref[Json] {
        @shared def empty: Json;
        def i: Int;
        for i = 0, i < this.keys.getLength(), ++i {
            if this.keys(i) == key {
                return this.values(i);
            }
        }
        return empty;
    }

    handler this(i: Int): ref[Json] {
        return this.values(i);
    }

    handler this.isNull(): Bool {
        if this.rawValue == "null" return true
        else return false;
    }

    handler this.isObject(): Bool {
        return this.keys.getLength() > 0;
    }

    handler this.isArray(): Bool {
        return this.values.getLength() > 0 && this.keys.getLength() == 0;
    }

    function escape(str: CharsPtr): String {
        def length: ArchInt = 0;
        def i: ArchInt = 0;
        while str~cnt(i) != 0 {
            if str~cnt(i) == '\n'
            or str~cnt(i) == '\r'
            or str~cnt(i) == '\t'
            or str~cnt(i) == '\\'
            or str~cnt(i) == '"' length += 2
            else ++length;
            ++i;
        }
        def res: String;
        res.alloc(length);
        length = 0;
        i = 0;
        while str~cnt(i) != 0 {
            if str~cnt(i) == '\n' {
                res.buf~cnt(length++) = '\\';
                res.buf~cnt(length++) = 'n';
            } else if str~cnt(i) == '\r' {
                res.buf~cnt(length++) = '\\';
                res.buf~cnt(length++) = 'r';
            } else if str~cnt(i) == '\t' {
                res.buf~cnt(length++) = '\\';
                res.buf~cnt(length++) = 't';
            } else if str~cnt(i) == '\\' {
                res.buf~cnt(length++) = '\\';
                res.buf~cnt(length++) = '\\';
            } else if str~cnt(i) == '"' {
                res.buf~cnt(length++) = '\\';
                res.buf~cnt(length++) = '"';
            } else {
                res.buf~cnt(length++) = str~cnt(i);
            }
            ++i;
        }
        res.buf~cnt(length++) = 0;
        return res;
    }    
    
    func stringfy [T : type] (obj : ref[T]): String {
        def sb : StringBuilder[JsonStringBuilderMixin](256, 256);
        sb.append('{');

        preprocess {
            _generateJsonStringify[T]()
        }

        sb.append('}');
        return sb~cast[String];
    }

    func parse [T : type] (obj : ref[T] , str: CharsPtr) {
        def json : Json(str);
        parse[T](obj, json);
    }

    func parse [T : type] (obj : ref[T] , json: ref[Json]) {
        preprocess {
            _generateJsonParse[T]()
        }
    }
}

import "casts.alusus";
import "ast_helpers.alusus";

def JsonStringBuilderMixin: {
    @format["jpc"]
    handler this.formatJsonCharsPtr(str: ptr[Char]) {
        this.append('"');
        while str~cnt != 0 {
            // For optimization purposes, we'll batch all non-escaped characters in a single append
            // operation.
            def c: Char;
            def len: ArchInt = 0;
            while 1 {
                c = (str + len)~cnt;
                if c == '\n' or c == '\r' or c == '\t' or c == '\\' or c == '"' or c == 0 break;
                ++len;
            }
            if len > 0 {
                this.append(str~cast[CharsPtr], len);
                str = str + len;
            }
            if c == 0 break;

            if c == '\n' {
                this.append("\\n");
            } else if c == '\r' {
                this.append("\\r");
            } else if c == '\t' {
                this.append("\\t");
            } else if c == '\\' {
                this.append("\\\\");
            } else if c == '"' {
                this.append("\\\"");
            }
            str = str + 1;
        }
        this.append('"');
    }

    @format["js"]
    handler this.formatJsonString(str: String) {
        this.formatJsonCharsPtr(str.buf);
    }

    @format["jns"]
    handler this.formatJsonNullableString(str: Nullable[String]) {
        if str.isNull this.append("null")
        else this.formatJsonCharsPtr(str.buf);
    }
    
    handler this.appendJsonValue(v: ptr[Char]) {
        if v == 0 this.append("null")
        else this.formatJsonCharsPtr(v);
    }

    handler this.appendJsonValue(v: CharsPtr) {
        this.appendJsonValue(v~cast[ptr[Char]]);
    }

    handler this.appendJsonValue(v: String) {
        this.formatJsonCharsPtr(v.buf);
    }

    handler this.appendJsonValue(v: Int[32]) {
        this.append(v);
    }

    handler this.appendJsonValue(v: Int[64]) {
        this.append(v);
    }

    handler this.appendJsonValue(v: Float[32]) {
        this.append(v);
    }

    handler this.appendJsonValue(v: Float[64]) {
        this.append(v);
    }

    handler this.appendJsonValue(v: Bool) {
        if v this.append("true")
        else this.append("false");
    }

    handler this.appendJsonValue(v: Nullable[String]) {
        if v.isNull this.append("null")
        else this.appendJsonValue(v.value);
    }

    handler this.appendJsonValue(v: Nullable[Int[32]]) {
        if v.isNull this.append("null")
        else this.append(v.value);
    }

    handler this.appendJsonValue(v: Nullable[Int[64]]) {
        if v.isNull this.append("null")
        else this.append(v.value);
    }

    handler this.appendJsonValue(v: Nullable[Float[32]]) {
        if v.isNull this.append("null")
        else this.append(v.value);
    }

    handler this.appendJsonValue(v: Nullable[Float[64]]) {
        if v.isNull this.append("null")
        else this.append(v.value);
    }

    handler this.appendJsonValue(v: Nullable[Bool]) {
        if v.isNull this.append("null")
        else if v.value this.append("true")
        else this.append("false");
    }
    
    handler [T: type] this.appendJsonArray(arr: ref[Array[T]]) {
        this.append('[');
        def i: Int;
        for i = 0, i < arr.getLength(), ++i {
            if i > 0 this.append(',');
            this.appendJsonValue(arr(i));
        }
        this.append(']');
    }

    handler [T: type] this.appendJsonMap(m: ref[Map[String, T]]) {
        this.append('{');
        def i: Int;
        for i = 0, i < m.getLength(), ++i {
            if i > 0 this.append(',');
            this.appendJsonValue(m.keyAt(i));
            this.append(':');
            this.appendJsonValue(m.valAt(i));
        }
        this.append('}');
    }

    handler this.appendJsonValue(v: Array[Nullable[String]]) {
        this.appendJsonArray[Nullable[String]](v);
    }

    handler this.appendJsonValue(v: Array[Nullable[Bool]]) {
        this.appendJsonArray[Nullable[Bool]](v);
    }

    handler this.appendJsonValue(v: Array[Nullable[Int[32]]]) {
        this.appendJsonArray[Nullable[Int[32]]](v);
    }

    handler this.appendJsonValue(v: Array[Nullable[Int[64]]]) {
        this.appendJsonArray[Nullable[Int[64]]](v);
    }

    handler this.appendJsonValue(v: Array[Nullable[Float[32]]]) {
        this.appendJsonArray[Nullable[Float[32]]](v);
    }

    handler this.appendJsonValue(v: Array[Nullable[Float[64]]]) {
        this.appendJsonArray[Nullable[Float[64]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Nullable[String]]) {
        this.appendJsonMap[Nullable[String]](v);
    }

    handler this.appendJsonValue(v: Map[String, Nullable[Bool]]) {
        this.appendJsonMap[Nullable[Bool]](v);
    }

    handler this.appendJsonValue(v: Map[String, Nullable[Int[32]]]) {
        this.appendJsonMap[Nullable[Int[32]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Nullable[Int[64]]]) {
        this.appendJsonMap[Nullable[Int[64]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Nullable[Float[32]]]) {
        this.appendJsonMap[Nullable[Float[32]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Nullable[Float[64]]]) {
        this.appendJsonMap[Nullable[Float[64]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Nullable[String]]]) {
        this.appendJsonMap[Array[Nullable[String]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Nullable[Bool]]]) {
        this.appendJsonMap[Array[Nullable[Bool]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Nullable[Int[32]]]]) {
        this.appendJsonMap[Array[Nullable[Int[32]]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Nullable[Int[64]]]]) {
        this.appendJsonMap[Array[Nullable[Int[64]]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Nullable[Float[32]]]]) {
        this.appendJsonMap[Array[Nullable[Float[32]]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Nullable[Float[64]]]]) {
        this.appendJsonMap[Array[Nullable[Float[64]]]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Nullable[String]]]) {
        this.appendJsonArray[Map[String, Nullable[String]]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Nullable[Bool]]]) {
        this.appendJsonArray[Map[String, Nullable[Bool]]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Nullable[Int[32]]]]) {
        this.appendJsonArray[Map[String, Nullable[Int[32]]]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Nullable[Int[64]]]]) {
        this.appendJsonArray[Map[String, Nullable[Int[64]]]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Nullable[Float[32]]]]) {
        this.appendJsonArray[Map[String, Nullable[Float[32]]]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Nullable[Float[64]]]]) {
        this.appendJsonArray[Map[String, Nullable[Float[64]]]](v);
    }

    handler this.appendJsonValue(v: Array[String]) {
        this.appendJsonArray[String](v);
    }

    handler this.appendJsonValue(v: Array[Bool]) {
        this.appendJsonArray[Bool](v);
    }

    handler this.appendJsonValue(v: Array[Int[32]]) {
        this.appendJsonArray[Int[32]](v);
    }

    handler this.appendJsonValue(v: Array[Int[64]]) {
        this.appendJsonArray[Int[64]](v);
    }

    handler this.appendJsonValue(v: Array[Float[32]]) {
        this.appendJsonArray[Float[32]](v);
    }

    handler this.appendJsonValue(v: Array[Float[64]]) {
        this.appendJsonArray[Float[64]](v);
    }

    handler this.appendJsonValue(v: Map[String, String]) {
        this.appendJsonMap[String](v);
    }

    handler this.appendJsonValue(v: Map[String, Bool]) {
        this.appendJsonMap[Bool](v);
    }

    handler this.appendJsonValue(v: Map[String, Int[32]]) {
        this.appendJsonMap[Int[32]](v);
    }

    handler this.appendJsonValue(v: Map[String, Int[64]]) {
        this.appendJsonMap[Int[64]](v);
    }

    handler this.appendJsonValue(v: Map[String, Float[32]]) {
        this.appendJsonMap[Float[32]](v);
    }

    handler this.appendJsonValue(v: Map[String, Float[64]]) {
        this.appendJsonMap[Float[64]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[String]]) {
        this.appendJsonMap[Array[String]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Bool]]) {
        this.appendJsonMap[Array[Bool]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Int[32]]]) {
        this.appendJsonMap[Array[Int[32]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Int[64]]]) {
        this.appendJsonMap[Array[Int[64]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Float[32]]]) {
        this.appendJsonMap[Array[Float[32]]](v);
    }

    handler this.appendJsonValue(v: Map[String, Array[Float[64]]]) {
        this.appendJsonMap[Array[Float[64]]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, String]]) {
        this.appendJsonArray[Map[String, String]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Bool]]) {
        this.appendJsonArray[Map[String, Bool]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Int[32]]]) {
        this.appendJsonArray[Map[String, Int[32]]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Int[64]]]) {
        this.appendJsonArray[Map[String, Int[64]]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Float[32]]]) {
        this.appendJsonArray[Map[String, Float[32]]](v);
    }

    handler this.appendJsonValue(v: Array[Map[String, Float[64]]]) {
        this.appendJsonArray[Map[String, Float[64]]](v);
    }
}
